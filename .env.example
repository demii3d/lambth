# Public site URL (no trailing slash). Used for canonical URLs, Open Graph, sitemap.xml and robots.txt.
VITE_SITE_URL=https://www.example.com

# Enquiry form endpoint (e.g. a Formspree / Basin / Getform URL, or your own API route).
# Receives a JSON POST. Leave empty to keep the form in its clearly-labelled development state.
VITE_FORM_ENDPOINT=
